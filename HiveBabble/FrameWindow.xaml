<Window x:Class="HiveBabble.FrameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hive-Babble" Width="640" Height="400" MinWidth="320" MinHeight="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ResizeMode="CanResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- Drag bar -->
    <Border x:Name="DragBar" Grid.Row="0" Background="#1E1E1E" BorderBrush="#E0A526" BorderThickness="2,2,2,0"
            MouseLeftButtonDown="DragBar_MouseLeftButtonDown">
      <DockPanel LastChildFill="False" Margin="6,0">
        <Path DockPanel.Dock="Left" Fill="#E0A526" VerticalAlignment="Center" Margin="2,0,6,0"
              Data="M7,0 L14,4 L14,12 L7,16 L0,12 L0,4 Z"/>
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#E0A526" FontWeight="Bold" Text="Hive-Babble"/>
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#99E0A526" FontStyle="Italic" Margin="8,0,0,0" Text="Read the world."/>
        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="×" ToolTip="Close" Click="Close_Click"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="⚙" ToolTip="Settings (M4)" Click="Settings_Click"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Mode ▾" ToolTip="Mode (M4)" Click="Placeholder_Click"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Lang ▾" ToolTip="Target language (M4)" Click="Placeholder_Click"/>
        <Button x:Name="PauseButton" DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Pause" Click="Pause_Click"/>
        <Button x:Name="LockButton" DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="🔓 Lock"
                ToolTip="Lock: frame becomes click-through. Unlock with Ctrl+Alt+L." Click="Lock_Click"/>
      </DockPanel>
    </Border>
    <!-- Frame interior: near-transparent so it is hit-testable when unlocked -->
    <Border Grid.Row="1" Background="#01000000" BorderBrush="#E0A526" BorderThickness="2"/>
    <Canvas x:Name="OverlayCanvas" Grid.Row="1" IsHitTestVisible="False"/>
    <TextBlock x:Name="StatusText" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8"
               Foreground="#E0A526" FontSize="11" IsHitTestVisible="False" Text="Unlocked"/>
    <!-- Hexagon corners -->
    <Grid Grid.RowSpan="2" IsHitTestVisible="False">
      <Path Fill="#E0A526" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M9,0 L18,5 L18,15 L9,20 L0,15 L0,5 Z"/>
      <Path Fill="#E0A526" HorizontalAlignment="Right" VerticalAlignment="Top" Data="M9,0 L18,5 L18,15 L9,20 L0,15 L0,5 Z"/>
      <Path Fill="#E0A526" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M9,0 L18,5 L18,15 L9,20 L0,15 L0,5 Z"/>
      <Path Fill="#E0A526" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M9,0 L18,5 L18,15 L9,20 L0,15 L0,5 Z"/>
    </Grid>
  </Grid>
</Window>