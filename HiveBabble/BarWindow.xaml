<Window x:Class="HiveBabble.BarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hive-Babble Bar" Height="34" Width="640" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False">
  <Border Background="#1E1E1E" BorderBrush="#E0A526" BorderThickness="2,2,2,0" MouseLeftButtonDown="Bar_MouseLeftButtonDown">
    <DockPanel LastChildFill="False" Margin="6,0">
      <Path DockPanel.Dock="Left" Fill="#E0A526" VerticalAlignment="Center" Margin="2,0,6,0" Data="M7,0 L14,4 L14,12 L7,16 L0,12 L0,4 Z"/>
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#E0A526" FontWeight="Bold" Text="Hive-Babble"/>
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#99E0A526" FontStyle="Italic" Margin="8,0,0,0" Text="Read the world."/>
      <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="×" ToolTip="Close" Click="Close_Click"/>
      <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="⚙" ToolTip="Settings (M4)" Click="Settings_Click"/>
      <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Mode ▾" ToolTip="Mode (M4)" Click="Placeholder_Click"/>
      <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Lang ▾" ToolTip="Target language (M4)" Click="Placeholder_Click"/>
      <Button x:Name="PauseButton" DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Pause" Click="Pause_Click"/>
      <Button x:Name="LockButton" DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="🔓 Lock"
              ToolTip="Lock: frame interior becomes click-through (Ctrl+Alt+L also toggles)" Click="Lock_Click"/>
    </DockPanel>
  </Border>
</Window>