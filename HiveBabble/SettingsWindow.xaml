<Window x:Class="HiveBabble.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hive-Babble Settings" Width="360" Height="200"
        Background="#1E1E1E" Topmost="True" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16">
    <TextBlock Foreground="#E0A526" FontWeight="Bold" FontSize="16" Text="Settings"/>
    <TextBlock Foreground="#E0A526" Margin="0,8,0,0" TextWrapping="Wrap"
               Text="Translator, API key (stored with DPAPI) and language settings arrive in M2/M4."/>
    <Button Content="Close" Style="{StaticResource BarButton}" HorizontalAlignment="Right" Margin="0,24,0,0" IsCancel="True"/>
  </StackPanel>
</Window>