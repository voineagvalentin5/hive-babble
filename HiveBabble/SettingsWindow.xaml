<Window Icon="pack://application:,,,/app.ico" x:Class="HiveBabble.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hive-Babble Settings" Width="420" SizeToContent="Height"
        Background="#1E1E1E" Foreground="#E0A526" Topmost="True" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock FontWeight="Bold" FontSize="16" Text="Settings"/>
    <TextBlock Margin="0,10,0,2" Text="Translator"/>
    <ComboBox x:Name="ProviderBox"/>
    <TextBlock Margin="0,10,0,2" Text="Local Libre server URL"/>
    <TextBox x:Name="LibreUrlBox"/>
    <TextBlock Margin="0,10,0,2" Text="API key (DeepL; stored encrypted with Windows DPAPI)"/>
    <PasswordBox x:Name="KeyBox"/>
    <TextBlock x:Name="KeyState" Margin="0,2,0,0" FontSize="11" Foreground="#99E0A526"/>
    <TextBlock Margin="0,10,0,2" Text="Source language (auto, es, en...)"/>
    <TextBox x:Name="SourceBox"/>
    <TextBlock Margin="0,10,0,2" Text="Target language (en, es...)"/>
    <TextBox x:Name="TargetBox"/>
    <TextBlock Margin="0,10,0,2" Text="OCR language (blank = Windows profile languages)"/>
    <ComboBox x:Name="OcrBox" IsEditable="True"/>
    <TextBlock x:Name="OcrState" Margin="0,2,0,0" FontSize="11" Foreground="#99E0A526" TextWrapping="Wrap"/>
    <TextBlock Margin="0,10,0,2" Text="Live refresh interval (ms)"/>
    <TextBox x:Name="LoopBox"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Save" Style="{StaticResource BarButton}" IsDefault="True" Click="Save_Click"/>
      <Button Content="Cancel" Style="{StaticResource BarButton}" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>